# ==============================================================================
# TRUV LedgerOS — n8n Automation Engine Deployment Configuration
# Copy this file to .env.n8n and supply secure values before launching docker compose
# ==============================================================================

# n8n Database Credentials (Dedicated PostgreSQL container or managed DB)
N8N_DB_USER=n8n_truv_admin
N8N_DB_PASSWORD=replace-with-a-64-char-random-db-password
N8N_DB_NAME=n8n_truv_ledgeros

# Critical: 32+ character hex encryption key for n8n credentials vault
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-64-char-hex-encryption-key-for-credentials-vault

# n8n Host and Domain
N8N_HOST=n8n.firm.truv.io
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.firm.truv.io/

# Core TRUV LedgerOS Webhook Integration Secret
# Used for HMAC-SHA256 signature verification on x-truv-signature
# Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=replace-with-shared-hmac-sha256-webhook-secret-min-32-chars

# Base URL of your TRUV LedgerOS application (where n8n will post action callbacks)
TRUV_LEDGEROS_BASE_URL=https://app.firm.truv.io

# Administrative Access Protection
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=truv_sysadmin
N8N_BASIC_AUTH_PASSWORD=replace-with-strong-admin-passphrase-min-16-chars

# Execution Pruning & Retention Configuration
EXECUTIONS_DATA_PRUNE=true
# 336 hours = 14 days
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000

# Timezone (Default for Indian Accounting & Tax Schedules: Asia/Kolkata)
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
