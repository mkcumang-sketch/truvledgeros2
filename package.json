{
  "name": "truv-ledgeros",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "node scripts/patch-prisma-cli.js && prisma generate",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/run-all-tests.js",
    "test:db-guard": "ts-node -r tsconfig-paths/register tests/db-readiness-guard.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:staging": "ts-node -r tsconfig-paths/register scripts/safe-migrate.ts",
    "prisma:seed": "prisma db seed",
    "outbox:worker": "ts-node -r tsconfig-paths/register scripts/outbox-worker.ts",
    "env:validate": "ts-node -r tsconfig-paths/register scripts/validate-env.ts",
    "db:readiness": "ts-node -r tsconfig-paths/register scripts/db-readiness.ts",
    "db:readiness:staging": "ts-node -r tsconfig-paths/register scripts/db-readiness.ts --enforce-staging",
    "db:inspect:readonly": "ts-node -r tsconfig-paths/register scripts/inspect-db-readonly.ts",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register scripts/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@marsidev/react-turnstile": "^1.6.2",
    "@prisma/client": "^5.22.0",
    "@supabase/server": "^1.9.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@types/ioredis": "^4.28.10",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.462.0",
    "next": "^14.2.18",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "playwright": "^1.64.1",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
