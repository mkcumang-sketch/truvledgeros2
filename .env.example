# ==============================================================================
# TRUVCA LedgerOS — Canonical Environment Configuration Template (.env.example)
# ==============================================================================
# This template contains placeholder values only.
# NEVER copy production credentials or real secrets into this file or Git history.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION URL & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="development" # Options: development | staging | production | test
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT="3000"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Cookie-backed sessions (truv_session) are active for 7 days by default.
# Cryptographic invitation tokens expire in 48 hours.
INVITATION_EXPIRY_HOURS="48"
NEXTAUTH_SECRET="replace-with-secure-random-32-byte-hex-string"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE (Supabase PostgreSQL / Local)
# ------------------------------------------------------------------------------
# Local Development default:
DATABASE_URL="postgresql://postgres:password@localhost:5432/truv_ledgeros?schema=public&connection_limit=20"
# Direct URL used for migration commands when using transaction poolers (e.g. Supabase, PgBouncer)
DIRECT_URL="postgresql://postgres:password@localhost:5432/truv_ledgeros?schema=public"

# ------------------------------------------------------------------------------
# 4. ENCRYPTION KEYRING & CREDENTIAL VAULT (AES-256-GCM)
# ------------------------------------------------------------------------------
# Must be exactly 64 hexadecimal characters (32 raw bytes).
# Required in staging and production to encrypt DSC PINs, portal credentials, and webhook secrets.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ENCRYPTION_KEY_M2M="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ENCRYPTION_KEY_M2M_PRIMARY_VERSION="1"
TOKEN_PEPPER="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
TOKEN_PEPPER_PRIMARY_VERSION="1"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Direct Gmail SMTP / Resend)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY="" # Fallback format: re_xxxxxxxxx
EMAIL_FROM="TRUV LedgerOS <notifications@truvledgeros.in>"

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE & WORKPAPERS (AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
# When credentials are unset, document uploads default to local storage or presign unavailable.
AWS_REGION="us-east-2"
AWS_ENDPOINT_URL_S3="" # Optional custom endpoint for Cloudflare R2 or local MinIO
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="truv-vault"

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# When unset, practices record collections manually via bank transfer/cash/cheque.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 8. WHATSAPP BUSINESS CLOUD API (Meta)
# ------------------------------------------------------------------------------
# Blocked pending Meta Business Verification. Email fallback active when unset.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ------------------------------------------------------------------------------
# 9. GST / GSP INTEGRATIONS (GSTN / ClearTax / MasterGST)
# ------------------------------------------------------------------------------
# Blocked pending commercial GSP license. Standard offline JSON/Excel import active when unset.
GSTN_API_BASE_URL="https://api.gst.gov.in"
GSTN_CLIENT_ID=""
GSTN_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 10. AI ADVISORY & NOTICE EXTRACTION (OpenAI / Google Gemini)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 11. CRON JOBS & NATIVE IN-PROCESS AUTOMATION ENGINE
# ------------------------------------------------------------------------------
# Constant-time token required to trigger /api/cron/process-automations and /api/cron/outbox-dispatch
CRON_SECRET=""
ENABLE_INPROCESS_OUTBOX_WORKER="false"
OUTBOX_POLL_INTERVAL_MS="10000"

# ------------------------------------------------------------------------------
# 12. DISTRIBUTED RATE LIMITER (Redis / Upstash)
# ------------------------------------------------------------------------------
# Optional. Falls back to in-memory sliding window limiter when unset.
REDIS_URL="" # Format: redis://default:password@host:6379 or rediss://...
RATE_LIMIT_REDIS_TIMEOUT_MS="1000"

# ------------------------------------------------------------------------------
# 13. MONITORING & DIAGNOSTICS (Sentry / Datadog)
# ------------------------------------------------------------------------------
SENTRY_DSN=""
LOG_LEVEL="info" # Options: debug | info | warn | error
