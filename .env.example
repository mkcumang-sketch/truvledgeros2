# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/truv_ledgeros?schema=public"

# Auth & Session Security (NextAuth / Auth.js)
NEXTAUTH_SECRET="replace-with-a-secure-random-secret-key-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"

# Automation Engine (n8n)
N8N_BASE_URL="http://localhost:5678"
N8N_WEBHOOK_SECRET="replace-with-hmac-sha256-webhook-secret"

# Credential Vault Encryption (AES-256-GCM)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# AI Provider (OpenAI / Gemini)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Multi-Channel Providers
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
EMAIL_PROVIDER_API_KEY=""
VOICE_PROVIDER_API_KEY=""

# Transactional Email Service (Resend)
# When RESEND_API_KEY is not set, TRUV LedgerOS runs in safe STANDBY_MODE (logs delivery intent, does not crash)
RESEND_API_KEY="re_123456789_abcdefg"
EMAIL_FROM="TRUV LedgerOS <notifications@truvledgeros.in>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
INVITATION_EXPIRY_HOURS="48"
