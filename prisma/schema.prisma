datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  GODMODE_ADMIN
  FIRM_OWNER
  FIRM_ADMIN
  PARTNER
  MANAGER
  EXECUTIVE
  CLIENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum InvoiceStatus {
  DRAFT
  AWAITING_APPROVAL
  REJECTED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentRecoveryStage {
  GENTLE
  FIRM
  FINAL_NOTICE
  PARTNER_ESCALATION
}

enum GstReturnType {
  GSTR_1
  GSTR_3B
  GSTR_9
  GSTR_9C
  CMP_08
}

enum GstReturnStatus {
  DATA_PENDING
  READY_FOR_REVIEW
  AWAITING_CLIENT_APPROVAL
  APPROVED_BY_CLIENT
  FILED
  REJECTED
}

enum DocumentStatus {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
}

enum CommunicationChannel {
  EMAIL
  WHATSAPP
  VOICE
  PORTAL
  WEB
  SMS
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

enum TaskType {
  INVOICE_APPROVAL
  PAYMENT_ESCALATION
  DOCUMENT_CALL
  GST_REVIEW
  AI_HANDOFF
  GENERAL
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum SubscriptionTier {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ==========================================
// 1. TENANT & MULTI-TENANCY
// ==========================================

model Tenant {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  gstin       String?
  pan         String?
  email       String
  phone       String
  address     String? @db.Text
  city        String?
  state       String?
  pincode     String?
  logoUrl     String? @db.Text
  active      Boolean @default(true)
  isSuspended Boolean @default(false)

  // Practice Configuration
  approvalThreshold  Decimal @default(50000.00) @db.Decimal(12, 2)
  defaultGstRate     Decimal @default(18.00) @db.Decimal(5, 2)
  defaultDueDays     Int     @default(15)
  recoveryGentleDays Int     @default(7)
  recoveryFirmDays   Int     @default(15)
  recoveryFinalDays  Int     @default(30)
  docReminderLimit   Int     @default(3)
  paymentLinkBase    String?
  uploadLinkBase     String?
  accountingSoftware String  @default("ZOHO_BOOKS")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  sessions         Session[] // <-- yeh line add karein
  clients          Client[]
  contacts         Contact[]
  invoices         Invoice[]
  payments         Payment[]
  gstProfiles      GstProfile[]
  gstReturns       GstReturn[]
  documents        Document[]
  docRequests      DocumentRequest[]
  tasks            Task[]
  communications   Communication[]
  conversations    Conversation[]
  automations      Automation[]
  automationEvents AutomationEvent[]
  knowledgeBases   KnowledgeBase[]
  subscription     Subscription?
  usageRecords     UsageRecord[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  integrations     Integration[]
  invitations      Invitation[]

  @@index([slug])
  @@index([active])
}

// ==========================================
// 2. USER & AUTHENTICATION
// ==========================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  phone        String?
  avatarUrl    String?  @db.Text
  isSuperAdmin Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships         Membership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     Invitation[]         @relation("InvitationsSent")
  tasksAssigned       Task[]               @relation("TaskAssignee")
  tasksCreated        Task[]               @relation("TaskCreator")
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@index([email])
}

// ==========================================
// 2.1 SESSION (Next.js Auth Store)
// ==========================================

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  tenantId     String?
  ipAddress    String?
  userAgent    String?  @db.Text
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([sessionToken])
}

// ==========================================
// 2.2 PASSWORD RESET TOKEN
// ==========================================

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// 2.3 INVITATION
// ==========================================

model Invitation {
  id          String           @id @default(cuid())
  tenantId    String
  email       String
  role        Role             @default(EXECUTIVE)
  permissions Json?
  tokenHash   String           @unique
  invitedById String
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([tokenHash])
  @@index([status])
}

// ==========================================
// 3. MEMBERSHIP (TENANT-USER RBAC LINK)
// ==========================================

model Membership {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  role        Role     @default(EXECUTIVE)
  status      String   @default("ACTIVE")
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@index([userId])
}

// ==========================================
// 4. CLIENT
// ==========================================

model Client {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  businessName String?
  gstin        String?
  pan          String?
  email        String
  phone        String
  city         String?
  state        String?
  pincode      String?
  planName     String?
  monthlyFee   Decimal  @default(0.00) @db.Decimal(12, 2)
  active       Boolean  @default(true)
  notes        String?  @db.Text
  portalUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  invoices       Invoice[]
  gstProfile     GstProfile?
  gstReturns     GstReturn[]
  documents      Document[]
  docRequests    DocumentRequest[]
  tasks          Task[]
  communications Communication[]
  conversations  Conversation[]

  @@index([tenantId, name])
  @@index([tenantId, gstin])
  @@index([tenantId, active])
}

// ==========================================
// 5. CONTACT
// ==========================================

model Contact {
  id          String   @id @default(cuid())
  tenantId    String
  clientId    String
  name        String
  designation String?
  email       String?
  phone       String
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
}

// ==========================================
// 6. INVOICE & LINE ITEMS
// ==========================================

model Invoice {
  id                 String                @id @default(cuid())
  tenantId           String
  clientId           String
  invoiceNumber      String
  serviceDescription String                @db.Text
  subtotal           Decimal               @db.Decimal(12, 2)
  gstRate            Decimal               @default(18.00) @db.Decimal(5, 2)
  cgstAmount         Decimal               @default(0.00) @db.Decimal(12, 2)
  sgstAmount         Decimal               @default(0.00) @db.Decimal(12, 2)
  igstAmount         Decimal               @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal               @db.Decimal(12, 2)
  issuedDate         DateTime              @default(now())
  dueDate            DateTime
  status             InvoiceStatus         @default(DRAFT)
  paidAt             DateTime?
  lastReminderAt     DateTime?
  lastRecoveryStage  PaymentRecoveryStage?
  promiseToPayDate   DateTime?
  syncedToBooks      Boolean               @default(false)
  accountingRefId    String?
  paymentLinkUrl     String?               @db.Text
  pdfUrl             String?               @db.Text
  createdById        String?
  approvedById       String?
  rejectionReason    String?               @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items          InvoiceItem[]
  payments       Payment[]
  tasks          Task[]
  communications Communication[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, dueDate])
  @@index([tenantId, createdAt])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String  @db.Text
  hsnSacCode  String?
  quantity    Decimal @default(1.00) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ==========================================
// 7. PAYMENT
// ==========================================

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  amount      Decimal  @db.Decimal(12, 2)
  paymentMode String // UPI, NEFT, RTGS, CHEQUE, CASH, GATEWAY
  referenceNo String?
  receivedAt  DateTime @default(now())
  notes       String?  @db.Text

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
}

// ==========================================
// 8. GST MANAGEMENT
// ==========================================

model GstProfile {
  id               String    @id @default(cuid())
  tenantId         String
  clientId         String    @unique
  gstin            String
  legalName        String
  tradeName        String?
  registrationDate DateTime?
  filingFrequency  String    @default("MONTHLY") // MONTHLY, QUARTERLY (QRMP)
  gstPortalUser    String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, gstin])
}

model GstReturn {
  id              String          @id @default(cuid())
  tenantId        String
  clientId        String
  returnType      GstReturnType
  period          String // e.g. "Sep 2026", "Q2 FY27"
  financialYear   String // e.g. "2026-2027"
  dueDate         DateTime
  dataReceived    Boolean         @default(false)
  outputTax       Decimal         @default(0.00) @db.Decimal(12, 2)
  inputTaxCredit  Decimal         @default(0.00) @db.Decimal(12, 2)
  netPayable      Decimal         @default(0.00) @db.Decimal(12, 2)
  status          GstReturnStatus @default(DATA_PENDING)
  dataRequestedAt DateTime?
  summarySentAt   DateTime?
  approvedAt      DateTime?
  filedAt         DateTime?
  arnNumber       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId, returnType, period])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, period])
}

// ==========================================
// 9. DOCUMENT REPOSITORIES & REQUESTS
// ==========================================

model DocumentRequest {
  id             String         @id @default(cuid())
  tenantId       String
  clientId       String
  title          String
  description    String?        @db.Text
  reminderCount  Int            @default(0)
  lastReminderAt DateTime?
  status         DocumentStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([tenantId, clientId])
  @@index([tenantId, status])
}

model Document {
  id              String         @id @default(cuid())
  tenantId        String
  clientId        String
  requestId       String?
  name            String
  fileUrl         String?        @db.Text
  fileSize        Int?
  mimeType        String?
  category        String // Bank Statement, Sales Register, Purchase Register, TDS, etc.
  status          DocumentStatus @default(PENDING)
  verifiedAt      DateTime?
  verifiedById    String?
  rejectionReason String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  request DocumentRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId])
  @@index([tenantId, status])
}

// ==========================================
// 10. TASK ENGINE
// ==========================================

model Task {
  id             String     @id @default(cuid())
  tenantId       String
  type           TaskType   @default(GENERAL)
  title          String
  detail         String?    @db.Text
  status         TaskStatus @default(OPEN)
  priority       String     @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  dueDate        DateTime?
  assignedToId   String?
  createdById    String?
  clientId       String?
  invoiceId      String?
  referenceId    String?
  completedAt    DateTime?
  resolutionNote String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  assignedTo User?    @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, assignedToId])
}

// ==========================================
// 11. COMMUNICATIONS & AI CONVERSATIONS
// ==========================================

model Communication {
  id          String                 @id @default(cuid())
  tenantId    String
  clientId    String?
  invoiceId   String?
  channel     CommunicationChannel
  direction   CommunicationDirection @default(OUTBOUND)
  purpose     String // INVOICE, RECOVERY, GST_DATA, GST_SUMMARY, DOCS, SUPPORT
  category    String
  recipient   String
  cc          String?
  subject     String?
  content     String                 @db.Text
  status      String // DELIVERED, ANSWERED, VOICEMAIL, NO_ANSWER, FAILED, INTERNAL
  externalRef String?
  createdAt   DateTime               @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, channel])
  @@index([tenantId, purpose])
  @@index([tenantId, createdAt])
}

model Conversation {
  id            String               @id @default(cuid())
  tenantId      String
  clientId      String?
  visitorName   String?
  visitorPhone  String?
  channel       CommunicationChannel @default(WEB)
  status        String               @default("AI_ACTIVE") // AI_ACTIVE, HANDOFF_REQUIRED, CLOSED
  lastMessageAt DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([tenantId, status])
  @@index([tenantId, channel])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderType     String // CLIENT, AI, TEAM
  senderName     String?
  content        String   @db.Text
  language       String? // hi, en, hinglish
  toolInvoked    String?
  sentAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  keywords  String   @db.Text // Comma separated keywords
  content   String   @db.Text
  category  String   @default("GENERAL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

// ==========================================
// 12. AUTOMATIONS & DOMAIN EVENTS
// ==========================================

model Automation {
  id           String    @id @default(cuid())
  tenantId     String
  code         String // INVOICE, RECOVERY, GST, DOCS, SUPPORT
  name         String
  description  String?   @db.Text
  cronSchedule String?
  enabled      Boolean   @default(true)
  totalRuns    Int       @default(0)
  lastRunAt    DateTime?
  config       Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutomationRun[]

  @@unique([tenantId, code])
  @@index([tenantId, enabled])
}

model AutomationRun {
  id           String   @id @default(cuid())
  automationId String
  triggeredAt  DateTime @default(now())
  status       String // SUCCESS, FAILED, RUNNING
  summary      String?  @db.Text
  errorDetails String?  @db.Text

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, triggeredAt])
}

model AutomationEvent {
  id             String      @id @default(cuid())
  tenantId       String
  eventType      String // invoice.created, invoice.approval_required, etc.
  entityType     String // INVOICE, GST_RETURN, DOCUMENT, CHAT
  entityId       String
  payload        Json
  status         EventStatus @default(PENDING)
  idempotencyKey String      @unique
  retryCount     Int         @default(0)
  errorMessage   String?     @db.Text
  createdAt      DateTime    @default(now())
  processedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, eventType])
  @@index([idempotencyKey])
}

// ==========================================
// 13. SUBSCRIPTION & USAGE
// ==========================================

model Subscription {
  id                 String           @id @default(cuid())
  tenantId           String           @unique
  tier               SubscriptionTier @default(TRIAL)
  status             String           @default("ACTIVE")
  currentPeriodStart DateTime         @default(now())
  currentPeriodEnd   DateTime
  maxUsers           Int              @default(5)
  maxClients         Int              @default(50)
  maxAiRuns          Int              @default(1000)
  maxVoiceMinutes    Int              @default(100)
  maxWhatsAppMsgs    Int              @default(1000)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id         String   @id @default(cuid())
  tenantId   String
  metric     String // AI_MESSAGE, VOICE_MINUTE, WHATSAPP_MESSAGE, STORAGE_MB
  quantity   Decimal  @default(1.00) @db.Decimal(10, 2)
  recordedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, metric, recordedAt])
}

// ==========================================
// 14. INTEGRATIONS, AUDIT & NOTIFICATIONS
// ==========================================

model Integration {
  id                   String    @id @default(cuid())
  tenantId             String
  provider             String // ZOHO_BOOKS, TALLY, QUICKBOOKS, WHATSAPP, SARVAM_VOICE, SMTP, OPENAI
  encryptedCredentials String    @db.Text
  iv                   String
  authTag              String
  status               String    @default("ACTIVE")
  lastTestedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  title     String
  message   String   @db.Text
  linkUrl   String?  @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
}
