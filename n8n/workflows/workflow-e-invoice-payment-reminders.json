{
  "name": "TRUV LedgerOS — Workflow E (Invoice & Payment Reminders)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "truv-events",
        "options": {
          "rawBody": true
        }
      },
      "id": "webhook-invoice-events",
      "name": "Invoice Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "truv-events-invoices"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "invoice-issued",
              "leftValue": "={{ $json.body.eventType }}",
              "rightValue": "invoice.issued",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "invoice-overdue",
              "leftValue": "={{ $json.body.eventType }}",
              "rightValue": "invoice.overdue",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "any"
        }
      },
      "id": "is-invoice-reminder-event",
      "name": "Is Invoice Reminder Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst event = $input.first().json.body;\nconst tenantId = event.tenantId;\nconst invoiceId = event.entityId || event.payload?.invoiceId;\nconst idempotencyKey = `idemp_inv_rem_${invoiceId}_${new Date().toISOString().slice(0, 10)}`;\nconst secret = $env.TRUV_LEDGEROS_WEBHOOK_SECRET || 'dev-n8n-webhook-hmac-sha256-secret';\nconst timestamp = Date.now().toString();\n\nconst payloadObj = {\n  action: 'SEND_INVOICE_REMINDER',\n  tenantId,\n  correlationId: `inv_rem_${invoiceId}`,\n  idempotencyKey,\n  payload: {\n    invoiceId,\n    eventType: event.eventType\n  }\n};\n\nconst payloadString = JSON.stringify(payloadObj);\nconst hmac = crypto.createHmac('sha256', secret);\nhmac.update(`${timestamp}.${payloadString}`);\nconst signature = `sha256=${hmac.digest('hex')}`;\n\nreturn [{\n  json: {\n    body: payloadObj,\n    signature,\n    timestamp\n  }\n}];"
      },
      "id": "prepare-invoice-reminder-payload",
      "name": "Prepare Reminder Payload & Sign HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUV_LEDGEROS_BASE_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-truv-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-truv-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "dispatch-invoice-reminder",
      "name": "Dispatch Invoice Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 240]
    }
  ],
  "connections": {
    "Invoice Event Webhook": {
      "main": [
        [
          {
            "node": "Is Invoice Reminder Event?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Invoice Reminder Event?": {
      "main": [
        [
          {
            "node": "Prepare Reminder Payload & Sign HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Reminder Payload & Sign HMAC": {
      "main": [
        [
          {
            "node": "Dispatch Invoice Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "TRUV-LedgerOS"
    },
    {
      "name": "Invoices"
    }
  ]
}
