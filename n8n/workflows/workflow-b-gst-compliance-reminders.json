{
  "name": "TRUV LedgerOS — Workflow B (GST & Compliance Reminders)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "schedule-daily-check",
      "name": "Daily 9:00 AM IST Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TRUV_LEDGEROS_BASE_URL }}/api/compliance/due-obligations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-truv-timestamp",
              "value": "={{ Date.now().toString() }}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "fetch-due-obligations",
      "name": "Fetch Due Obligations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Filter returns that are DATA_PENDING or READY_FOR_REVIEW and not FILED\nconst crypto = require('crypto');\nconst obligations = $input.first().json.obligations || [];\nconst secret = $env.TRUV_LEDGEROS_WEBHOOK_SECRET || 'dev-n8n-webhook-hmac-sha256-secret';\nconst results = [];\n\nfor (const item of obligations) {\n  if (item.status !== 'FILED') {\n    const timestamp = Date.now().toString();\n    const payloadObj = {\n      action: 'SEND_COMPLIANCE_REMINDER',\n      tenantId: item.tenantId,\n      correlationId: `gst_${item.id}_${Date.now()}`,\n      idempotencyKey: `idemp_gst_rem_${item.id}_${new Date().toISOString().slice(0, 10)}`,\n      payload: {\n        returnId: item.id,\n        returnType: item.returnType,\n        period: item.period,\n        dueDate: item.dueDate,\n        clientId: item.clientId\n      }\n    };\n\n    const payloadString = JSON.stringify(payloadObj);\n    const hmac = crypto.createHmac('sha256', secret);\n    hmac.update(`${timestamp}.${payloadString}`);\n    const signature = `sha256=${hmac.digest('hex')}`;\n\n    results.push({\n      json: {\n        body: payloadObj,\n        signature,\n        timestamp\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "id": "filter-unfiled-obligations",
      "name": "Filter Unfiled Obligations & Sign HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUV_LEDGEROS_BASE_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-truv-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-truv-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "dispatch-compliance-reminder",
      "name": "Dispatch Compliance Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Daily 9:00 AM IST Schedule": {
      "main": [
        [
          {
            "node": "Fetch Due Obligations",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Due Obligations": {
      "main": [
        [
          {
            "node": "Filter Unfiled Obligations & Sign HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Unfiled Obligations & Sign HMAC": {
      "main": [
        [
          {
            "node": "Dispatch Compliance Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "TRUV-LedgerOS"
    },
    {
      "name": "GST"
    }
  ]
}
