{
  "name": "TRUV LedgerOS — Workflow A (Client Onboarding)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "truv-events",
        "options": {
          "rawBody": true
        }
      },
      "id": "webhook-trigger-node",
      "name": "LedgerOS Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "truv-events-onboarding"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "event-type-filter",
              "leftValue": "={{ $json.body.eventType }}",
              "rightValue": "client.created",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "event-bulk-filter",
              "leftValue": "={{ $json.body.eventType }}",
              "rightValue": "clients.bulk_imported",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "any"
        }
      },
      "id": "filter-onboarding-events",
      "name": "Is Onboarding Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Prepare authorized request to LedgerOS inbound API with HMAC-SHA256 signature\nconst crypto = require('crypto');\nconst event = $input.first().json.body;\nconst tenantId = event.tenantId;\nconst clientId = event.entityId || event.payload?.clientId;\nconst correlationId = `onb_${event.eventId || Date.now()}`;\nconst idempotencyKey = `idemp_onb_${clientId}_${event.eventType}`;\nconst secret = $env.TRUV_LEDGEROS_WEBHOOK_SECRET || 'dev-n8n-webhook-hmac-sha256-secret';\nconst timestamp = Date.now().toString();\n\nconst payloadObj = {\n  action: 'CREATE_ONBOARDING_TASKS',\n  tenantId,\n  correlationId,\n  idempotencyKey,\n  payload: {\n    clientId,\n    clientName: event.payload?.name || 'New Practice Client',\n    entityType: event.payload?.entityType || 'PRIVATE_LIMITED'\n  }\n};\n\nconst payloadString = JSON.stringify(payloadObj);\nconst hmac = crypto.createHmac('sha256', secret);\nhmac.update(`${timestamp}.${payloadString}`);\nconst signature = `sha256=${hmac.digest('hex')}`;\n\nreturn [{\n  json: {\n    body: payloadObj,\n    signature,\n    timestamp\n  }\n}];"
      },
      "id": "prepare-onboarding-payload",
      "name": "Prepare Task Payload & Sign HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUV_LEDGEROS_BASE_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-truv-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-truv-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "create-onboarding-tasks-call",
      "name": "Call LedgerOS Inbound API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 240]
    }
  ],
  "connections": {
    "LedgerOS Event Webhook": {
      "main": [
        [
          {
            "node": "Is Onboarding Event?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Onboarding Event?": {
      "main": [
        [
          {
            "node": "Prepare Task Payload & Sign HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Task Payload & Sign HMAC": {
      "main": [
        [
          {
            "node": "Call LedgerOS Inbound API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  },
  "tags": [
    {
      "name": "TRUV-LedgerOS"
    },
    {
      "name": "Onboarding"
    }
  ]
}
